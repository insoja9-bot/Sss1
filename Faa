local function travelTo(name)
    local pos = Islands[name]
    if not pos or not CommF then return end
    pcall(function()
        CommF:InvokeServer("TravelMain")
        CommF:InvokeServer("TravelDressrosa")
        CommF:InvokeServer("TravelZou")
        -- الانتقال المباشر
        local r = getRoot()
        if r then r.CFrame = pos end
    end)
end

-- ==========================================
--  الزراعة الذكية (Auto Farm)
-- ==========================================
local function getClosestEnemy()
    local root = getRoot()
    if not root then return nil end
    local best, bestD = nil, S.FarmDistance

    -- البحث في كل مكان بالخريطة
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "HumanoidRootPart" and obj.Parent ~= LocalPlayer.Character then
            local model = obj.Parent
            if model and isAlive(model) then
                local isEnemy = model:FindFirstChildOfClass("Humanoid") and 
                    not Players:GetPlayerFromCharacter(model)
                if isEnemy then
                    local d = (obj.Position - root.Position).Magnitude
                    if d < bestD then bestD, best = d, model end
                end
            end
        end
    end
    return best
end

