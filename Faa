-- إعادة المهمة عند نهايتها
local function checkQuest()
    if not CommF or not S.AutoQuest then return end
    local lvl = LocalPlayer:GetAttribute("Level") or 1
    pcall(function()
        CommF:InvokeServer("StartQuest", "FirstSea", lvl)
        CommF:InvokeServer("StartQuest", "SecondSea", lvl)
        CommF:InvokeServer("StartQuest", "ThirdSea", lvl)
    end)
end

-- ضرب العدو
local function attack(target)
    local char = getChar()
    local root = getRoot()
    if not char or not root or not target then return end
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    if not tRoot then return end

    -- الاقتراب
    local offset = tRoot.CFrame.LookVector * -3 + Vector3.new(0, 0, 0)
    pcall(function()
        root.CFrame = CFrame.lookAt(tRoot.Position + offset, tRoot.Position)
    end)

    -- تفعيل السلاح
    if S.AutoSword then
        pcall(function() CommF:InvokeServer("StoreFruit", "Sword") end)
    end

    -- ضرب
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
end

