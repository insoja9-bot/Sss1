-- ==========================================
--  صندوق ذكي (Auto Chest Smart)
-- ==========================================
local function getChests()
    local chests = {}
    local root = getRoot()
    if not root then return chests end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("MeshPart") and obj.Name:lower():find("chest") then
            local parent = obj.Parent
            if parent and parent:FindFirstChild("HumanoidRootPart") then
                local d = (parent.HumanoidRootPart.Position - root.Position).Magnitude
                if d <= S.ChestRadius then
                    table.insert(chests, parent)
                end
            end
        end
    end
    return chests
end

task.spawn(function()
    while task.wait() do
        if S.AutoChest then
            local chests = getChests()
            if #chests > 0 then
                -- نأخذ الأقرب
                local root = getRoot()
                if root then
                    table.sort(chests, function(a, b)
                        return (a.HumanoidRootPart.Position - root.Position).Magnitude <
                               (b.HumanoidRootPart.Position - root.Position).Magnitude
                    end)
                    local target = chests[1]
                    pcall(function()
                        root.CFrame = target.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                    end)
                    -- تأخير عشوائي ذكي (حتى ما يرجعك)
                    task.wait(math.random(S.ChestMinDelay * 10, S.ChestMaxDelay * 10) / 10)
                end
            else
                task.wait(0.5)
            end
        else
            task.wait(0.3)
        end
    end
end)

